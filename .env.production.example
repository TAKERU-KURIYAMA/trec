# Application Settings
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration
DB_HOST=db
DB_PORT=1433
DB_NAME=MessageRDB
DB_USER=sa
DB_PASSWORD=Your_Strong_Password_Here!@#2024
SA_PASSWORD=Your_Strong_Password_Here!@#2024

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Your_Redis_Password_Here!

# JWT Configuration
JWT_SECRET=Your_Very_Long_Random_String_Here_At_Least_64_Characters_Long!@#$%^&*()
JWT_ISSUER=trecplans.com
JWT_AUDIENCE=trecplans_users
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_MIN=43200

# API URLs
NUXT_PUBLIC_API_BASE_URL=https://your-domain.com/api
API_BASE_URL=http://api:80

# Frontend Settings
NUXT_HOST=0.0.0.0
NUXT_PORT=80

# SSL Certificate paths
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem

# Logging
LOG_LEVEL=info
LOG_PATH=/var/log/trecplans

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
GRAFANA_PASSWORD=change_me_admin_password