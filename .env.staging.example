# Staging Environment Configuration

# Application Settings
NODE_ENV=staging
ASPNETCORE_ENVIRONMENT=Staging

# Database Configuration
DB_HOST=db
DB_PORT=1433
DB_NAME=MessageRDB_Staging
DB_USER=sa
DB_PASSWORD=Staging_Password_Here!@#2024
SA_PASSWORD=Staging_Password_Here!@#2024

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Staging_Redis_Password!

# JWT Configuration
JWT_SECRET=Staging_JWT_Secret_At_Least_64_Characters_Long_For_Security!@#$%^&*()
JWT_ISSUER=staging-trecplans.com
JWT_AUDIENCE=staging_trecplans_users
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_MIN=43200

# API URLs
NUXT_PUBLIC_API_BASE_URL=https://staging-trecplans.com/api
API_BASE_URL=http://api:80

# Frontend Settings
NUXT_HOST=0.0.0.0
NUXT_PORT=80

# SSL Certificate paths
SSL_CERT_PATH=/etc/letsencrypt/live/staging-trecplans.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/staging-trecplans.com/privkey.pem

# Logging
LOG_LEVEL=debug
LOG_PATH=/var/log/trecplans

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
GRAFANA_PASSWORD=staging_grafana_password